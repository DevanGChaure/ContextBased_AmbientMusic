# Copy this file to ".env" (same folder) and fill in your real key(s).
# .env is loaded automatically by config.py — no shell exports needed.

# Required if DIRECTOR_PROVIDER=gemini (the default)
GEMINI_API_KEY=

# Required if DIRECTOR_PROVIDER=groq
GROQ_API_KEY=

# Which provider the Director uses: "gemini" or "groq"
DIRECTOR_PROVIDER=gemini
